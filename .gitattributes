# ---------------------------------------------------------------
# AegisMR: .gitattributes
# Put this file in the ROOT of the repo, next to .gitignore.
# Git LFS must be installed for the "filter=lfs" lines to work.
# ---------------------------------------------------------------

# Let Git normalise line endings for text files
* text=auto

# Source and data files
*.cs text diff=csharp
*.py text
*.md text
*.json text

# Unity YAML files (text, keep LF line endings so merges stay clean)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# ----- Large binary files go through Git LFS -----
# 3D models and Blender files
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

# Audio and video
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Large textures and image sources
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Unity packages
*.unitypackage filter=lfs diff=lfs merge=lfs -text
